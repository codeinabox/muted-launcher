{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "semanticCommitType": "chore",
  "packageRules": [
    {
      "description": "Gradle libraries default to fix (runtime libs ship in the APK)",
      "matchManagers": ["gradle"],
      "semanticCommitType": "fix"
    },
    {
      "description": "Build plumbing override: plugins (AGP, Kotlin, detekt, ktfmt) and wrapper -> build",
      "matchManagers": ["gradle", "gradle-wrapper"],
      "excludePackagePrefixes": ["androidx."],
      "semanticCommitType": "build"
    },
    {
      "description": "Test-only libraries -> chore (never shipped)",
      "matchPackageNames": [
        "junit:junit",
        "androidx.test.ext:junit",
        "androidx.test:runner"
      ],
      "semanticCommitType": "chore"
    },
    {
      "description": "Detekt Compose lint rules -> chore (analysis tooling, never in the APK)",
      "matchPackagePrefixes": ["io.nlopez.compose.rules"],
      "semanticCommitType": "chore"
    },
    {
      "description": "GitHub Actions -> ci",
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci"
    }
  ]
}
